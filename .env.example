# =========================
# Core Storage & Healthcheck
# =========================
DB_PATH=/app/data/ai_stack_trends.db
HEALTHCHECK_FILE=/app/data/heartbeat.txt
LOG_LEVEL=INFO

# =========================
# Telegram Delivery
# =========================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SEND_STARTUP_MESSAGE=true
SEND_EMPTY_DIGEST=false
INCLUDE_ALERTS_IN_DIGEST=false
SEND_RAW_FETCH_REPORT=false
SEND_RAW_FETCH_JSON=false

# =========================
# OpenRouter LLM Classifier
# =========================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
DEBUG_LLM=false

# =========================
# Two-Phase Scheduler & Queue Pipeline
# =========================
FETCH_MINUTES=10
DIGEST_MINUTES=360

MAX_CANDIDATES_PER_RUN=180
MAX_CANDIDATES_PER_FLUSH=96
CANDIDATE_QUEUE_MAX=360

QUEUE_FLUSH_LIMIT=32
CHECK_QUEUE_SECONDS=60
FORCE_FLUSH_MINUTES=30
MAX_ITEM_RETRIES=5

LLM_BATCH_SIZE=8
LLM_MIN_SCORE=7.0
ALERT_THRESHOLD=8.5
LLM_TEXT_FIELD_MAX_CHARS=500

MAX_ALERTS_PER_FLUSH=8
DIGEST_MAX_ITEMS=10

# =========================
# Feed Resilience & Concurrency
# =========================
FEED_FAILURE_THRESHOLD=4
FEED_COOLDOWN_MINUTES=60
HN_FETCH_WORKERS=8
ARXIV_FETCH_WORKERS=4

# =========================
# Research & Community Sources
# =========================
ENABLE_ARXIV=true
ARXIV_RESULTS_PER_CATEGORY=20
# Scoped to the 10 AI Models & Software Stack layers (Quantum removed to eliminate overlap with ai-hardware-bot)
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.MA,cs.DC,cs.PL,cs.DB,cs.SE,cs.IR,cs.HC

ENABLE_HACKERNEWS=true
# Polls topstories + beststories and keeps only stories meeting HN_MIN_SCORE
HN_STORIES_PER_RUN=60
HN_MIN_SCORE=15

ENABLE_TECHMEME=true
TECHMEME_MAX_ITEMS=40

# =========================
# Step 1: Specialist AI Stack & Frontier Lab RSS/Atom Feeds
# =========================
# Format uses | between feeds and NAME=URL for each feed.
# A URL may contain ';;'-separated direct fallback URLs.
ENABLE_SPECIALIST_RSS=true
SPECIALIST_RSS_MAX_ITEMS_PER_FEED=12
SPECIALIST_RSS_FEEDS=PyTorch Blog=https://pytorch.org/feed.xml;;https://pytorch.org/blog/feed.xml|Hugging Face Blog=https://huggingface.co/blog/feed.xml|NVIDIA Developer Blog=https://developer.nvidia.com/blog/feed/|DuckDB Blog=https://duckdb.org/feed.xml|LangChain Blog=https://blog.langchain.com/rss/|Qdrant Blog=https://qdrant.tech/blog/index.xml|OpenAI News=https://openai.com/news/rss.xml|Google DeepMind Blog=https://deepmind.google/blog/rss.xml|Google Research Blog=https://research.google/blog/rss/|The Register AI=https://www.theregister.com/software/ai_ml/headlines.atom

# =========================
# Step 2: Core OSS Ecosystem Release Feeds (GitHub Atom)
# =========================
ENABLE_ECOSYSTEM_RELEASES_RSS=true
ECOSYSTEM_RELEASES_MAX_ITEMS_PER_FEED=8
ECOSYSTEM_RELEASES_RSS_FEEDS=vLLM Releases=https://github.com/vllm-project/vllm/releases.atom|SGLang Releases=https://github.com/sgl-project/sglang/releases.atom|llama.cpp Releases=https://github.com/ggml-org/llama.cpp/releases.atom|PyTorch Releases=https://github.com/pytorch/pytorch/releases.atom|Transformers Releases=https://github.com/huggingface/transformers/releases.atom|Ray Releases=https://github.com/ray-project/ray/releases.atom|Polars Releases=https://github.com/pola-rs/polars/releases.atom|LiteLLM Releases=https://github.com/BerriAI/litellm/releases.atom|Open WebUI Releases=https://github.com/open-webui/open-webui/releases.atom

# =========================
# HTML Scrapers (Dedicated Per-Source + Universal Fallback)
# =========================
# Format: Label=PageURL[;;OptionalURLPattern]|Label2=PageURL2...
# Dedicated scrapers handle vLLM, Unsloth, Ollama, Polars, AMD ROCm, Anthropic, and Meta AI directly.
ENABLE_HTML_SCRAPER=true
HTML_SCRAPER_MAX_ITEMS_PER_SITE=12
HTML_SCRAPER_TARGETS=vLLM Blog=https://vllm.ai/blog|Unsloth Blog=https://unsloth.ai/blog|Ollama Blog=https://ollama.com/blog|Polars Blog=https://pola.rs/posts/|AMD ROCm Blogs=https://rocm.blogs.amd.com/|Anthropic News=https://www.anthropic.com/news|Anthropic Research=https://www.anthropic.com/research|Meta AI Blog=https://ai.meta.com/blog/
# Optional: residential/ISP proxy URL or Jina Reader API key if your VPS IP hits Cloudflare challenges.
# SCRAPER_PROXY_URL=
# JINA_API_KEY=

# =========================
# Step 3: SEC EDGAR — Optional Market-Wide Full-Text Search (EFTS)
# =========================
ENABLE_SEC_EDGAR=false
# SEC asks for a descriptive user agent with contact info. Replace with your email/domain.
SEC_USER_AGENT=AI-Models-Stack-Bot/1.1 your_email@example.com
SEC_FORMS=8-K,10-Q,10-K,S-1,F-1,20-F,6-K
SEC_LOOKBACK_DAYS=3
SEC_MAX_ITEMS_PER_FETCH=40
SEC_EFTS_QUERY='"CUDA" OR "ROCm" OR "TensorRT" OR "vLLM" OR "FlashAttention" OR "vector database" OR "quantization" OR "foundation model" OR "inference engine" OR "test-time compute" OR "autonomous agent"'
